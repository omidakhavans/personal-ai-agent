# Local development only. Copy to .env before running Make targets.
# Do not reuse these values in a shared or production environment.
POSTGRES_DB=personal_ai_agent
POSTGRES_USER=personal_ai_agent
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

API_PORT=8000
ADMIN_PORT=5173
DOCS_PORT=3000

# Browser origins allowed to call the local API. Do not use a wildcard.
PERSONAL_AI_AGENT_CORS_ORIGINS=http://localhost:5173
